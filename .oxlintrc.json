{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-console": "off",
    "no-inline-comments": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-statements": "off"
  },
  "ignorePatterns": ["dist/**", "bin/**", "go/**", "node_modules/**", "test/ingres/*.js"],
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/prefer-top-level-await": "off"
      }
    }
  ]
}
