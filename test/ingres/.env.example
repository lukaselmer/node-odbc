# Configuration for the Ingres tests.
#
# Copy this file to test/ingres/.env and fill in the values. That file is
# gitignored: the host, the credentials and the exact driver build are internal
# and must not end up in this repository, which is mirrored publicly.
#
# Colleagues: the values are documented with the consuming application in the
# repository of the consuming application, under its docs directory.

# Ingres server the tests connect to.
INGRES_HOST=
INGRES_USER=
INGRES_PASSWORD=

# Name of the DSN in odbcinst.ini/odbc.ini, and of the vnode the client uses to
# reach the server.
INGRES_DSN=
INGRES_VNODE=

# Directory holding the Actian client archive together with the odbc.ini and
# odbcinst.ini that select its driver.
ACTIAN_ASSETS_DIR=

# File name of the Actian client archive inside that directory. Pinned per
# environment rather than in this repository, so the build stays reproducible
# without publishing which build is deployed.
ACTIAN_CLIENT_ARCHIVE=

# Only needed by runInPod.sh, which runs the tests inside an already configured
# pod instead of building a container.
KUBE_CONTEXT=
KUBE_NAMESPACE=
KUBE_POD=
KUBE_CONTAINER=
