{
  "name": "@lukaselmer/odbc",
  "version": "3.0.0-gosidecaralpha.2",
  "description": "unixodbc bindings for node",
  "homepage": "https://github.com/lukaselmer/node-odbc",
  "bugs": {
    "url": "https://github.com/lukaselmer/node-odbc/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Mark Irish",
      "email": "mirish@ibm.com"
    },
    {
      "name": "Dan VerWeire",
      "email": "dverweire@gmail.com"
    },
    {
      "name": "Lee Smith",
      "email": "notwink@gmail.com"
    },
    {
      "name": "Lukas Elmer",
      "email": "lukas.elmer@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/lukaselmer/node-odbc.git"
  },
  "files": [
    "dist/",
    "go/",
    "bin/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/odbc.d.ts",
      "default": "./dist/odbc.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:types",
    "build:server": "node scripts/buildServer.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:types && npm run lint:code && npm run lint:format",
    "lint:types": "tsc --noEmit",
    "lint:code": "oxlint --type-aware",
    "lint:format": "oxfmt --check .",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
